---
// WritingList — extracted from v2 src/pages/index.astro `<!-- 6. Writing -->` block.
// Self-contained: pulls top 3 non-draft essays, reverse-chronological.
import { getCollection } from "astro:content";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<section>
  <h2>writing</h2>
  <ul class="writing-list">
    {essays.map((e) => (
      <li>
        <a href={`/writing/${e.slug}`}>
          <span class="mono faint" style="font-size: var(--small);">
            {e.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })}
          </span>
          <span style="margin-left: 1rem;">{e.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="mono muted" style="font-size: var(--small); margin-top: 0.75rem;">
    all → <a href="/writing">/writing</a>
  </p>
</section>

<style>
  .writing-list {
    list-style: none;
  }
  .writing-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .writing-list a {
    background-image: none;
  }
  .writing-list a:hover {
    color: var(--accent);
  }
</style>
