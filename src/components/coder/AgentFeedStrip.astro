---
// src/components/coder/AgentFeedStrip.astro
//
// One curated line, expires_at-gated. No React, no worker, no polling.
// Source of truth: src/data/feed-summary.ts
import { FEED_SUMMARY } from "../../data/feed-summary";

const now = Date.now();
const active =
  FEED_SUMMARY && new Date(FEED_SUMMARY.expires_at).getTime() > now
    ? FEED_SUMMARY
    : null;
---
{active && (
  <div class="feed-strip" data-component="agent-feed-strip" data-expires-at={active.expires_at}>
    <span class="live">● LIVE</span>
    <span class="feed-strip__text">
      {active.href
        ? <a href={active.href}>{active.text}</a>
        : <span>{active.text}</span>}
      <span class="feed-strip__time mono" data-ts={active.ts}></span>
    </span>
    <span class="feed-strip__changelog"><a href="/changelog">/changelog →</a></span>
  </div>
)}

<script>
  // Live-tick the relative time and vanish the strip when expires_at passes.
  const strip = document.querySelector<HTMLElement>('[data-component="agent-feed-strip"]');
  if (strip) {
    const expiresAt = new Date(strip.dataset.expiresAt || '').getTime();
    const tsEl = strip.querySelector<HTMLElement>('[data-ts]');
    const ts = tsEl ? new Date(tsEl.dataset.ts || '').getTime() : 0;
    const rel = (ms: number) => {
      const s = Math.floor(ms / 1000);
      if (s < 60) return `${s}s ago`;
      if (s < 3600) return `${Math.floor(s / 60)}m ago`;
      if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
      return `${Math.floor(s / 86400)}d ago`;
    };
    const tick = () => {
      if (Date.now() > expiresAt) { strip.remove(); return; }
      if (tsEl) tsEl.textContent = ' · ' + rel(Date.now() - ts);
    };
    tick();
    setInterval(tick, 60_000);
  }
</script>

<style>
  .feed-strip__text {
    flex: 1; min-width: 0;
    text-overflow: ellipsis; overflow: hidden; white-space: nowrap;
  }
  .feed-strip__text a { color: inherit; text-decoration: none; }
  .feed-strip__text a:hover { color: var(--accent); }
  .feed-strip__time { color: var(--fg-faint); font-size: var(--tiny); margin-left: 0.4rem; }
  .feed-strip__changelog { margin-left: auto; }
  .feed-strip__changelog a { color: inherit; text-decoration: none; }
  .feed-strip__changelog a:hover { color: var(--accent); }
</style>
