---
// src/components/coder/WorkshopHero.astro
// Eyebrow-name treatment: name as small mono eyebrow above three display lines.
// H1 still leads with "Ashish Kshirsagar" for SEO + a11y (first text node).
//   #3  Human handhold — portrait, city, contact links above the fold
//   #7  Hero font-size now clamp()'d in coder.css for 320px viewports
//   #11 Gradient text-fill removed (solid color on <h1>)
//   v4 polish r3 W1: portrait routed through astro:assets (WebP, ~5-15KB).
//   v4 polish r3 W6: contact strip now has 4 links (email, LI, GitHub, Twitter).
import { Image } from "astro:assets";
import portrait from "../../assets/profile.jpeg";
import { social } from "../../data/social";

export interface Props {
  stats?: {
    activeProjects: number;
  };
}
const { stats = { activeProjects: 5 } } = Astro.props;
---
<section class="hero">
  <div class="hero-pre">~ §1 · the workshop ~</div>

  <header class="workshop-h1">
    <h1 class="workshop-h1__eyebrow">Ashish Kshirsagar</h1>
    <p class="workshop-h1__line">Software Engineer at Microsoft</p>
    <p class="workshop-h1__line">Shipping updates on Windows</p>
    <p class="workshop-h1__line workshop-h1__line--stance">Agentic AI enthusiast</p>
  </header>

  <div class="hero-handhold">
    <Image
      src={portrait}
      alt="Portrait of Ashish Kshirsagar"
      width={192}
      height={192}
      quality={80}
      format="webp"
      loading="eager"
      class="hero-portrait"
    />
    <div class="hero-handhold-text">
      <div class="hero-contacts">
        <a href="mailto:ashishkshirsagar10@gmail.com">ashishkshirsagar10@gmail.com</a>
        <span class="hero-sep">·</span>
        <a href="https://linkedin.com/in/ask149" target="_blank" rel="noopener noreferrer">linkedin.com/in/ask149</a>
        <span class="hero-sep">·</span>
        <a href="https://github.com/ask149" target="_blank" rel="noopener noreferrer">github.com/ask149</a>
        <span class="hero-sep">·</span>
        <a href={social.twitter} target="_blank" rel="noopener noreferrer">{social.twitterHandle}</a>
      </div>
      <div class="hero-receipts">
        <span class="hero-receipts__label">Previously:</span>
        <span class="hero-receipts__list">Microsoft · Tesla · Amazon · Barclays · Google · CERN-HSF</span>
      </div>
    </div>
  </div>

  <div class="hero-meta">
    <span><strong>{stats.activeProjects}</strong> active projects</span>
  </div>
</section>
