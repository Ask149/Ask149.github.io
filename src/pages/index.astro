---
import PersonaLayout from "../layouts/PersonaLayout.astro";
import CoderHero from "../components/coder/CoderHero.astro";
import { ProjectGrid } from "../components/coder/ProjectGrid";
import LiveFeed from "../components/LiveFeed";
import ManifestoTeaser from "../components/coder/ManifestoTeaser.astro";
import CurrentlyBlurb from "../components/coder/CurrentlyBlurb.astro";
import WritingList from "../components/coder/WritingList.astro";
import CareerTimeline from "../components/coder/CareerTimeline.astro";
import ConnectLinks from "../components/coder/ConnectLinks.astro";
import { getCollection } from "astro:content";

const FEED_ENDPOINT = "https://ask149-feed.workers.dev/events.json";

// Schema (src/content/config.ts): { title, description, status, tags?, order?, url?, repo? }
// No `blurb`, `featured`, `cover`, `date`, or `draft` fields. Adapt accordingly.
// `as any` casts on p.data keep this resilient to schema drift in later phases.
const projectsRaw = await getCollection("projects");
const projects = projectsRaw
  .sort((a, b) => {
    const ad = a.data as any;
    const bd = b.data as any;
    const ao = ad.order ?? 999;
    const bo = bd.order ?? 999;
    return ao - bo;
  })
  .map((p) => {
    const d = p.data as any;
    return {
      slug: p.slug,
      title: d.title,
      blurb: d.blurb ?? d.description ?? "",
      tags: d.tags ?? [],
      url: d.url,
      cover: d.cover
        ? typeof d.cover === "string"
          ? { src: d.cover, alt: d.coverAlt ?? "" }
          : { src: d.cover.src, alt: d.coverAlt ?? d.cover.alt ?? "" }
        : undefined,
      featured: d.featured ?? false,
    };
  });

const allTags = Array.from(
  new Set(projects.flatMap((p) => p.tags))
).sort();
---
<PersonaLayout
  personaId="coder"
  title="Ashish Kshirsagar — Senior SWE, vibe-coding with 4 agents"
  description="Coder portfolio: projects, manifesto, live agent feed."
>
  <CoderHero />
  <LiveFeed endpoint={FEED_ENDPOINT} client:load />
  <div class="divider">▍ ▍ ▍</div>
  <ManifestoTeaser />
  <CurrentlyBlurb />
  <ProjectGrid projects={projects} allTags={allTags} client:visible />
  <WritingList />
  <CareerTimeline />
  <ConnectLinks />
</PersonaLayout>

<style>
  .divider {
    text-align: center;
    color: var(--fg-faint);
    font-family: var(--mono, monospace);
    letter-spacing: 0.5em;
    margin: 1.5rem 0;
    user-select: none;
  }
</style>
