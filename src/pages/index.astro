---
// src/pages/index.astro — Workshop (§1)
import { getCollection } from "astro:content";
import PersonaLayout from "../layouts/PersonaLayout.astro";
// REVIEW-2026-05-18 #10: SchematicBackground removed — 30px grid is the single
// background language. Component file retained but no longer imported anywhere.
import AgentFeedStrip from "../components/coder/AgentFeedStrip.astro";
import WorkshopHero from "../components/coder/WorkshopHero.astro";
import ProjectGridV4 from "../components/coder/ProjectGridV4.tsx";

// Schema (src/content/config.ts) for `projects`:
//   { title, description, status, tags?, order?, url?, repo? }
// No `blurb`, `featured`, `cover`, `shippedDate`, or `draft`.
// We graceful-default missing fields via `as any` casts, same pattern as v3.
const projectEntries = await getCollection("projects", (e) => !(e.data as any).draft);
const projects = projectEntries
  .sort((a, b) => {
    const ao = (a.data as any).order ?? 999;
    const bo = (b.data as any).order ?? 999;
    return ao - bo;
  })
  .map((e, i) => {
    const d = e.data as any;
    return {
      slug: e.slug,
      title: d.title,
      description: d.description,
      status: d.status,
      tags: d.tags ?? [],
      order: d.order ?? i + 1,
      url: d.url,
      featured: d.featured ?? i === 0,
      shipped: d.shipped,
    };
  });

const activeCount = projects.filter((p) => p.status === "active").length;
const proofCards = [
  {
    label: "Windows systems",
    title: "Ships production software at Microsoft",
    body: "Servicing and update work where reliability, reviews, and release discipline matter.",
  },
  {
    label: "Agent systems",
    title: "Builds with AI agents in the loop",
    body: "OpenCode/Copilot workflows, MCP servers, review gates, and small automation loops.",
  },
  {
    label: "IODevz",
    title: "Active project workbench",
    body: "A small founder collective for experiments that earn their way into public projects.",
  },
] as const;

const lastEditISO = projectEntries
  .map((e) => (e.data as any)?.shippedDate?.toISOString?.() ?? null)
  .filter(Boolean)
  .sort()
  .reverse()[0] ?? undefined;
---
<PersonaLayout
  personaId="coder"
  title="Ashish Kshirsagar — Software Engineer at Microsoft"
  description="Software Engineer at Microsoft. Ships Windows updates and builds agent-assisted developer systems."
  lastEditISO={lastEditISO}
>
  <AgentFeedStrip />
  <WorkshopHero stats={{ activeProjects: activeCount || projects.length }} />

  <section class="proof-strip" aria-labelledby="proof-strip-title">
    <h2 class="proof-strip__label" id="proof-strip-title">→ §1.1 · selected receipts</h2>
    <div class="proof-grid">
      {proofCards.map((card) => (
        <article class="proof-card" data-tilt>
          <p class="proof-card__label">{card.label}</p>
          <h2>{card.title}</h2>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="projects">
    <div class="projects-label">→ §1.2 · selected work</div>
    <ProjectGridV4 client:visible projects={projects} />
  </section>
</PersonaLayout>
