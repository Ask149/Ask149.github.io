---
import Base from '../layouts/Base.astro'
---
<Base title="404 · Ashish Kshirsagar">
  <main class="notfound">
    <h1>404 — not found</h1>
    <p>This page doesn't exist (yet). Try one of these:</p>
    <ul class="notfound-links">
      <li><a href="/">/</a> — home</li>
      <li><a href="/traveler">/traveler</a> — voyages</li>
      <li><a href="/curate">/curate</a> — reading + curio</li>
      <li><a href="/made">/made</a> — atelier</li>
      <li><a href="/resume">/resume</a> — resume</li>
    </ul>

    <pre class="json-404"><code>{`{
  "error": "page_not_found",
  "model": "Ask149.brain",
  "tokens_used": 0,
  "suggestion": "try / or /feed",
  "easter_eggs": [
    "/sudo",
    "/agents",
    "/cost"
  ]
}`}</code></pre>
  </main>
  <style>
    .notfound {
      max-width: 640px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      font-family: var(--font-serif);
      color: var(--fg);
    }
    .notfound h1 {
      font-family: var(--font-mono);
      font-size: 2rem;
      letter-spacing: -0.01em;
      margin: 0 0 1rem;
      color: var(--fg);
    }
    .notfound p { margin: 0 0 1rem; }
    .notfound-links {
      list-style: none;
      padding: 0;
      margin: 0 0 2rem;
      font-family: var(--font-mono);
      font-size: 0.95rem;
    }
    .notfound-links li { padding: 0.25rem 0; }
    .notfound-links a { color: var(--accent); }
    .json-404 {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--fg-muted);
      background: var(--surface);
      border: 1px solid var(--rule);
      padding: 1.5rem;
      margin: 2rem 0;
    }
    .json-404 code { color: var(--accent); }
  </style>
</Base>
