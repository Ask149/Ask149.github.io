---
// src/pages/made.astro
// WIP stub. The atelier persona is wired into the registry + tokens + hero so
// it can be flipped back on cheaply when a real build ships, but until then
// it's hidden from TopNav (registry: hideFromNav) and the page itself shows
// an honest empty-state card instead of placeholder grids + a fake bench count.
import PersonaLayout from "../layouts/PersonaLayout.astro";
import AtelierSchematicBg from "../components/made/AtelierSchematicBg.astro";

const lastEditISO = new Date().toISOString();
---
<PersonaLayout
  personaId="made"
  title="Ashish K. · atelier"
  description="Physical things — soldered, sawn, sketched. Workbench is closed for now."
  lastEditISO={lastEditISO}
>
  <AtelierSchematicBg />
  <main class="atelier-wip">
    <article class="card">
      <p class="kicker mono">§ 04 · atelier</p>
      <h1>workbench closed</h1>
      <p class="lede">
        Nothing on the bench worth showing yet. This page will come back when
        something physical actually ships — soldered, sawn, or sketched.
      </p>
      <p class="back">
        <a href="/">← back to the workshop</a>
      </p>
    </article>
  </main>
</PersonaLayout>

<style>
  .atelier-wip {
    min-height: 60vh;
    display: grid;
    place-items: center;
    padding: 6rem 1.5rem;
  }
  .card {
    max-width: 36rem;
    text-align: center;
  }
  .kicker {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  h1 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: 0.02em;
    color: var(--fg);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--fg);
    margin: 0 0 2.25rem;
  }
  .back {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  .back a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.1rem;
  }
  .back a:hover { opacity: 0.8; }
</style>
